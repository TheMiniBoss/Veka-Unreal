// Backdrop (Phase 4): the area behind a Veka element, blurred with a dual Kawase pyramid, composited inside the
// element's rounded shape with a tint.

#include "/Engine/Private/Common.ush"

Texture2D InputTexture;
SamplerState InputSampler;
// 1 / size of the input texture.
float2 InputTexelSize;
// 1 / size of the render target (the pyramid levels start at 0, 0).
float2 OutputTexelSize;

// Dual Kawase downsample: the center and four diagonal taps at half a texel.
void KawaseDownPS(noperspective float4 UVAndScreenPos : TEXCOORD0, float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const float2 UV = SvPosition.xy * OutputTexelSize;
	const float2 H = InputTexelSize * 0.5;
	float4 Sum = InputTexture.SampleLevel(InputSampler, UV, 0) * 4.0;
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2(-H.x, -H.y), 0);
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2( H.x, -H.y), 0);
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2(-H.x,  H.y), 0);
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2( H.x,  H.y), 0);
	OutColor = Sum / 8.0;
}

// Dual Kawase upsample: four edge taps at one texel and four diagonal taps at half a texel (weight 2).
void KawaseUpPS(noperspective float4 UVAndScreenPos : TEXCOORD0, float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const float2 UV = SvPosition.xy * OutputTexelSize;
	const float2 H = InputTexelSize * 0.5;
	float4 Sum = 0;
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2(-H.x * 2.0, 0), 0);
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2( H.x * 2.0, 0), 0);
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2(0, -H.y * 2.0), 0);
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2(0,  H.y * 2.0), 0);
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2(-H.x,  H.y), 0) * 2.0;
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2( H.x,  H.y), 0) * 2.0;
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2(-H.x, -H.y), 0) * 2.0;
	Sum += InputTexture.SampleLevel(InputSampler, UV + float2( H.x, -H.y), 0) * 2.0;
	OutColor = Sum / 12.0;
}

// Composite (output = the window's back buffer, pixel coordinates).
// The two pyramid levels around the backdrop's radius, mixed by LevelMix (any radius, smooth when animated).
Texture2D LowerTexture;
Texture2D UpperTexture;
float LevelMix;
// Element rect in pixels (Min, Size) and the captured rect the levels cover (Min, 1 / Size).
float4 ElementRect;
float4 CaptureRect;
// Corner radii in pixels: top left, top right, bottom right, bottom left.
float4 CornerRadii;
float4 Tint;
float Saturation;
float Noise;
float Opacity;

float RoundedRectDistance(float2 P, float2 HalfSize, float4 Radii)
{
	// Radius of the quadrant P is in.
	float R = P.x < 0 ? (P.y < 0 ? Radii.x : Radii.w) : (P.y < 0 ? Radii.y : Radii.z);
	R = min(R, min(HalfSize.x, HalfSize.y));
	const float2 Q = abs(P) - HalfSize + R;
	return min(max(Q.x, Q.y), 0.0) + length(max(Q, 0.0)) - R;
}

// Stable per-pixel grain in [-0.5, 0.5].
float Grain(float2 Pixel)
{
	return frac(sin(dot(floor(Pixel), float2(12.9898, 78.233))) * 43758.5453) - 0.5;
}

void CompositePS(noperspective float4 UVAndScreenPos : TEXCOORD0, float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const float2 Pixel = SvPosition.xy;
	const float2 HalfSize = ElementRect.zw * 0.5;
	const float Distance = RoundedRectDistance(Pixel - (ElementRect.xy + HalfSize), HalfSize, CornerRadii);
	const float Coverage = saturate(0.5 - Distance);

	const float2 BlurUV = (Pixel - CaptureRect.xy) * CaptureRect.zw;
	const float3 Lower = LowerTexture.SampleLevel(InputSampler, BlurUV, 0).rgb;
	const float3 Upper = UpperTexture.SampleLevel(InputSampler, BlurUV, 0).rgb;
	float3 Color = lerp(Lower, Upper, LevelMix);
	const float Luma = dot(Color, float3(0.2126, 0.7152, 0.0722));
	Color = lerp(Luma.xxx, Color, Saturation);
	Color = lerp(Color, Tint.rgb, Tint.a);
	Color += Grain(Pixel) * Noise;
	OutColor = float4(max(Color, 0.0), Coverage * Opacity);
}

// Liquid glass (output = the back buffer, pixel coordinates). The shapes (rounded rects, min.xy max.xy and radii),
// merged with a smooth minimum, refract the capture near their edge (the bezel) along the normal of the field.
float4 ShapeRects[8];
float4 ShapeRadii[8];
int NumShapes;
float Smoothness;
float Refraction;
float Bezel;
float Aberration;
float Highlight;
float2 LightPosition;

float SmoothMin(float A, float B, float K)
{
	if (K <= 0.0)
	{
		return min(A, B);
	}
	const float H = saturate(0.5 + 0.5 * (B - A) / K);
	return lerp(B, A, H) - K * H * (1.0 - H);
}

float GlassField(float2 P)
{
	float D = 1e6;
	for (int Index = 0; Index < NumShapes; ++Index)
	{
		const float4 Rect = ShapeRects[Index];
		const float2 HalfSize = (Rect.zw - Rect.xy) * 0.5;
		const float Shape = RoundedRectDistance(P - (Rect.xy + HalfSize), HalfSize, ShapeRadii[Index]);
		D = Index == 0 ? Shape : SmoothMin(D, Shape, Smoothness);
	}
	return D;
}

float3 SampleBlurred(float2 Pixel)
{
	const float2 UV = (Pixel - CaptureRect.xy) * CaptureRect.zw;
	return lerp(LowerTexture.SampleLevel(InputSampler, UV, 0).rgb, UpperTexture.SampleLevel(InputSampler, UV, 0).rgb, LevelMix);
}

void GlassPS(noperspective float4 UVAndScreenPos : TEXCOORD0, float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const float2 Pixel = SvPosition.xy;
	const float D = GlassField(Pixel);
	const float Coverage = saturate(0.5 - D);
	if (Coverage <= 0.0)
	{
		OutColor = 0;
		return;
	}

	// Outward normal of the merged shape.
	const float E = 1.0;
	float2 Normal = float2(GlassField(Pixel + float2(E, 0)) - GlassField(Pixel - float2(E, 0)), GlassField(Pixel + float2(0, E)) - GlassField(Pixel - float2(0, E)));
	Normal = Normal / max(length(Normal), 1e-4);

	// 0 at the edge, 1 past the bezel: the curved rim bends the background, most at the edge.
	const float Depth = saturate(-D / Bezel);
	const float Rim = 1.0 - Depth;
	const float Lens = Rim * Rim;
	const float2 Offset = Normal * Refraction * Lens;

	// Chromatic aberration: red bends more than blue.
	float3 Color;
	Color.r = SampleBlurred(Pixel + Offset * (1.0 + Aberration)).r;
	Color.g = SampleBlurred(Pixel + Offset).g;
	Color.b = SampleBlurred(Pixel + Offset * (1.0 - Aberration)).b;

	const float Luma = dot(Color, float3(0.2126, 0.7152, 0.0722));
	Color = lerp(Luma.xxx, Color, Saturation);
	Color = lerp(Color, Tint.rgb, Tint.a);

	// Specular rim lit from the light (the pointer), a softer one all around.
	const float2 ToLight = normalize(LightPosition - Pixel);
	const float Facing = saturate(dot(Normal, ToLight));
	Color += Highlight * pow(Rim, 3.0) * (0.25 + 0.75 * Facing);

	OutColor = float4(max(Color, 0.0), Coverage * Opacity);
}
